{
  "name": "studyquest",
  "version": "1.0.0",
  "description": "Turn each university quarter into a game run, with objectives, evidence checks, prestige tiers and a pixel character.",
  "author": "Panayiotis Angelides",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImPanyAngel/StudyQuest.git"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "gamification",
    "study"
  ],
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
